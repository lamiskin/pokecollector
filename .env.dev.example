# PokéCollector Dev instance — copy to .env.dev and fill in, never commit.
#
# Start with:  ./scripts/instance.sh dev up -d
# Project isolation: each instance is a separate compose project, so container
# names, the postgres volume and the network are all distinct. Host paths below
# keep media separate as well.

COMPOSE_PROJECT_NAME=pokecollector-dev

# Fork images, built once from the release commit (see docs/DEPLOYMENT.md).
BACKEND_IMAGE=pokecollector-backend:dev
FRONTEND_IMAGE=pokecollector-frontend:dev

# Bind to loopback only. A new instance has no login until credentials are
# configured, so a Dev stack must never listen on a LAN or VPN interface.
BACKEND_PORT=127.0.0.1:18000
FRONTEND_PORT=127.0.0.1:13000

# Own secrets. Generate: openssl rand -hex 32
POSTGRES_PASSWORD=replace-me
JWT_SECRET_KEY=replace-me
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-me

# Authentication policy: `local` keeps username/password login only, `mixed`
# adds single sign-on for linked accounts, and `oidc-only` disables password
# login (it requires an administrator already linked in mixed mode).
# Leave blank or set `local` for the current behaviour; unknown values fail startup.
AUTH_MODE=local
# Single sign-on (OIDC). One issuer per instance. Only `mixed`/`oidc-only`
# activate OIDC; provider settings alone never enable it in local mode.
# Issuer and redirect URI must be absolute HTTPS URLs; plain HTTP is accepted
# only for literal localhost/127.0.0.1/[::1] development.
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
# Set the secret only in your private .env file; never commit a real value.
OIDC_CLIENT_SECRET=
# Must end with the exact path /api/auth/oidc/callback on the public origin.
OIDC_REDIRECT_URI=
OIDC_DISPLAY_NAME=Single sign-on

# Dev is internal-only; PUBLIC_MODE is not access control.
PUBLIC_MODE=false

# Never send messages from Dev.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Separate storage from Prod.
BACKUPS_DIR=./instances/dev/backups
AUTH_DIR=./instances/dev/auth
POKEDEX_IMAGE_DIR=./instances/dev/pokedex-images
SCAN_UPLOAD_HOST_DIR=./instances/dev/scan-uploads
SCAN_TRACE_HOST_DIR=./instances/dev/scan-traces

# Scanner: point at a development provider only.
GEMINI_API_KEY=
OPENAI_SCANNER_ENABLED=false
OPENAI_BASE_URL=
