# PokéCollector Prod instance — copy to .env.prod and fill in, never commit.
#
# Start with:  ./scripts/instance.sh prod up -d
# Prod owns the real collection and its own secrets, media and backups.

COMPOSE_PROJECT_NAME=pokecollector-prod

# Pinned fork images from the tested release candidate, by digest. Copy these
# two lines from that release's pokecollector.env.example asset
# (docs/FORK_DEPLOYMENT.md); never substitute upstream images.
BACKEND_IMAGE=pokecollector-backend:prod
FRONTEND_IMAGE=pokecollector-frontend:prod

# Bind address: keep loopback unless this host is behind an authenticated
# reverse proxy. An instance with no configured login must not be exposed.
BACKEND_PORT=127.0.0.1:8000
FRONTEND_PORT=127.0.0.1:3000

# Own secrets. Generate: openssl rand -hex 32
POSTGRES_PASSWORD=replace-me
JWT_SECRET_KEY=replace-me
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-me

# Authentication policy: `local` keeps username/password login only, `mixed`
# adds single sign-on for linked accounts, and `oidc-only` disables password
# login (it requires an administrator already linked in mixed mode).
# Leave blank or set `local` for the current behaviour; unknown values fail startup.
AUTH_MODE=local
# Single sign-on (OIDC). One issuer per instance. Only `mixed`/`oidc-only`
# activate OIDC; provider settings alone never enable it in local mode.
# Issuer and redirect URI must be absolute HTTPS URLs; plain HTTP is accepted
# only for literal localhost/127.0.0.1/[::1] development.
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
# Set the secret only in your private .env file; never commit a real value.
OIDC_CLIENT_SECRET=
# Must end with the exact path /api/auth/oidc/callback on the public origin.
OIDC_REDIRECT_URI=
OIDC_DISPLAY_NAME=Single sign-on

PUBLIC_MODE=false

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

BACKUPS_DIR=./instances/prod/backups
AUTH_DIR=./instances/prod/auth
POKEDEX_IMAGE_DIR=./instances/prod/pokedex-images
SCAN_UPLOAD_HOST_DIR=./instances/prod/scan-uploads
SCAN_TRACE_HOST_DIR=./instances/prod/scan-traces

GEMINI_API_KEY=
OPENAI_SCANNER_ENABLED=false
OPENAI_BASE_URL=
