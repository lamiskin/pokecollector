# PokéCollector Prod instance — copy to .env.prod and fill in, never commit.
#
# Start with:  ./scripts/instance.sh prod up -d
# Prod owns the real collection and its own secrets, media and backups.

COMPOSE_PROJECT_NAME=pokecollector-prod

# Pinned fork images from the tested release candidate, by tag and, once
# recorded, by digest (docs/DEPLOYMENT.md).
BACKEND_IMAGE=pokecollector-backend:prod
FRONTEND_IMAGE=pokecollector-frontend:prod

# Bind address: keep loopback unless this host is behind an authenticated
# reverse proxy. An instance with no configured login must not be exposed.
BACKEND_PORT=127.0.0.1:8000
FRONTEND_PORT=127.0.0.1:3000

# Own secrets. Generate: openssl rand -hex 32
POSTGRES_PASSWORD=replace-me
JWT_SECRET_KEY=replace-me
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-me

PUBLIC_MODE=false

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

BACKUPS_DIR=./instances/prod/backups
AUTH_DIR=./instances/prod/auth
POKEDEX_IMAGE_DIR=./instances/prod/pokedex-images
SCAN_UPLOAD_HOST_DIR=./instances/prod/scan-uploads
SCAN_TRACE_HOST_DIR=./instances/prod/scan-traces

GEMINI_API_KEY=
OPENAI_SCANNER_ENABLED=false
OPENAI_BASE_URL=
